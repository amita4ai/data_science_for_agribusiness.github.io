text = paste("Country:", name, "<br>Total Cost:", total_cost))) +
scale_fill_viridis_c(option = "plasma", na.value = "grey90") +
theme_minimal() +
labs(title = "Total Average Cost for Two by Country")
p
#install.packages("plotly")
library(plotly)
