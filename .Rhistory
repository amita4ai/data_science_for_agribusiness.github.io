# Install required packages (if not already installed)
#install.packages(c("ggplot2", "gganimate", "dplyr", "gifski", "transformr"))
library(ggplot2)
library(gganimate)
library(dplyr)
# Step 1: Prepare dataset
bubble_data <- zomato2 %>%
group_by(country_name, price_range) %>%
summarise(
avg_cost = mean(average_cost_for_two, na.rm = TRUE),
avg_rating = mean(aggregate_rating, na.rm = TRUE),
total_votes = sum(votes, na.rm = TRUE)
) %>%
ungroup()
# Step 2: Plot with ggplot + gganimate
p <- ggplot(bubble_data, aes(x = avg_cost,
y = avg_rating,
size = total_votes,
color = country_name)) +
geom_point(alpha = 0.7) +
scale_size(range = c(3, 15), guide = "none") +
labs(
title = "Cost vs Rating Dynamics Across Price Ranges",
subtitle = "Price Range: {closest_state}",
x = "Average Cost for Two",
y = "Average Customer Rating",
color = "Country"
) +
theme_minimal(base_size = 14) +
transition_states(price_range, transition_length = 2, state_length = 1) +
ease_aes('cubic-in-out')
# Step 3: Render animation
animate(p, nframes = 100, fps = 10, width = 800, height = 600, renderer = gifski_renderer("bubble_chart.gif"))
# Example: 3D plot with cost, rating, and votes
fig <- plot_ly(
data = zomato2,
x = ~average_cost_for_two,    # X-axis
y = ~aggregate_rating,        # Y-axis
z = ~votes,                   # Z-axis
color = ~country_name,        # Color by country
size = ~votes,                # Bubble size
type = "scatter3d",
mode = "markers",
marker = list(opacity = 0.7)
)
fig <- fig %>% layout(
title = "3D View: Cost vs Rating vs Popularity",
scene = list(
xaxis = list(title = "Average Cost for Two"),
yaxis = list(title = "Aggregate Rating"),
zaxis = list(title = "Votes")
)
)
fig
