install.packages("networkD3")
# Install and load required packages
#install.packages("networkD3")
library(networkD3)
# Step 1: Prepare data for Sankey
links <- zomato %>%
count(price_range, has_table_booking, has_online_delivery, name = "value")
# Step 2: Reshape into long format for Sankey
links_long <- bind_rows(
links %>% select(source = price_range, target = has_table_booking, value),
links %>% select(source = has_table_booking, target = has_online_delivery, value)
)
# Step 3: Create unique nodes
nodes <- data.frame(name = unique(c(links_long$source, links_long$target)))
# Step 4: Map node IDs
links_long$source <- match(links_long$source, nodes$name) - 1
links_long$target <- match(links_long$target, nodes$name) - 1
# Step 5: Build Sankey Diagram
sankeyNetwork(Links = links_long, Nodes = nodes,
Source = "source", Target = "target",
Value = "value", NodeID = "name",
sinksRight = FALSE, fontSize = 12, nodeWidth = 30)
